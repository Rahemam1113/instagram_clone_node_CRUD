<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css"/>
    <title>Instagram</title>
</head>
<body>
     <%for(post of posts){%>
    <div class="main">
        <div>
            <img class="profile" src="<%= post.image %>" alt="<%= post.username %> profile image" width="120" height="120">
            <h4> <%= post.id %> </h4>
            <h4> <%= post.username %> </h4>
            <p> <%= post.name %> </p>
            <div  class="content">
            <p class="cont"> <%= post.postsCount %> posts </p>
            <p class="cont"> <%= post.followers %> followers</p>
            <p class="cont"> <%= post.following %> following</p>
            </div>
        </div>
        <p> <%= post.content %> </p>
        <a href="http://localhost:3000/posts/<%= post.id %>/edit">Edit content</a>
        <br><br>
        <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
            <button type="submit">Delete</button>
        </form>
    </div>
    
    <%}%>
</body>
</html>